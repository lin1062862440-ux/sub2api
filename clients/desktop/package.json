{
  "name": "linai-desktop",
  "private": true,
  "version": "0.1.8",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:visual": "vite --mode visual --port 1421",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest",
    "test:run": "vitest run",
    "test:tools": "node --test tools/*.node-test.mjs",
    "brand:sync": "node scripts/sync-brand.mjs",
    "updater:manifest": "node tools/write-updater-manifest.mjs",
    "release:windows": "node tools/release-windows.mjs",
    "android:init": "tauri android init --ci --skip-targets-install",
    "android:dev": "tauri android dev",
    "android:icons": "node scripts/sync-android-icons.mjs",
    "android:apk": "pnpm android:icons && tauri android build --debug --apk --target aarch64 --ci",
    "android:release": "pnpm android:icons && node tools/android-release.mjs",
    "android:manifest": "node tools/write-android-updater-manifest.mjs",
    "android:publish": "node tools/publish-android-gitee-release.mjs",
    "build:installer:windows:ui": "vite build --config vite.installer.config.ts",
    "dev:installer:windows": "vite --config vite.installer.config.ts",
    "bundle:windows": "pnpm bundle:windows:x64",
    "bundle:windows:x64": "node scripts/build-windows-installer.mjs --target x86_64-pc-windows-msvc",
    "bundle:windows:x86": "node scripts/build-windows-installer.mjs --target i686-pc-windows-msvc",
    "bundle:macos": "pnpm brand:sync && PATH=/usr/bin:/bin:/usr/sbin:/sbin:$PATH APPLE_SIGNING_IDENTITY=${APPLE_SIGNING_IDENTITY:--} TAURI_SIGNING_PRIVATE_KEY=\"${TAURI_SIGNING_PRIVATE_KEY:-$(cat ${TAURI_SIGNING_PRIVATE_KEY_PATH:-$HOME/.tauri/linai-updater.key})}\" TAURI_SIGNING_PRIVATE_KEY_PASSWORD=${TAURI_SIGNING_PRIVATE_KEY_PASSWORD:-} tauri build --bundles app,dmg"
  },
  "dependencies": {
    "@lucide/vue": "^1.28.0",
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-deep-link": "^2.4.9",
    "@tauri-apps/plugin-http": "^2.5.9",
    "@tauri-apps/plugin-opener": "^2.5.4",
    "@tauri-apps/plugin-os": "^2.3.2",
    "@tauri-apps/plugin-process": "^2.3.1",
    "@tauri-apps/plugin-store": "^2.4.4",
    "@tauri-apps/plugin-updater": "^2.10.1",
    "echarts": "^6.1.0",
    "vue": "^3.5.40",
    "vue-echarts": "^8.0.1",
    "vue-router": "^4.6.4"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.4",
    "@types/node": "^24.13.3",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/test-utils": "^2.4.11",
    "@vue/tsconfig": "^0.9.1",
    "@xmldom/xmldom": "^0.9.10",
    "happy-dom": "^20.11.1",
    "sharp": "^0.35.3",
    "typescript": "~6.0.2",
    "vite": "^8.2.0",
    "vitest": "^4.1.10",
    "vue-tsc": "^3.3.8"
  }
}
